# Copy this file to .env and fill in your values
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Use a random value of at least 32 characters in production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30d
NODE_ENV=development
PORT=5000
# One exact frontend origin. Comma-separated values are supported for multiple deployments.
CLIENT_URL=http://localhost:5173
# Optional explicit additional origins.
# CORS_ORIGINS=https://your-frontend.example.com
# Preview wildcard origins are disabled by default.
# ALLOW_PREVIEW_ORIGINS=false
# BODY_LIMIT=64kb
